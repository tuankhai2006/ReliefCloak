# true = chạy không cần TideCloak (mã hóa giả, chọn vai bằng nút). Dùng để code song song.
# false = dùng TideCloak thật (cần tidecloak.json sau khi chạy `npm run init`).
NEXT_PUBLIC_TIDE_MOCK=true

# Optional absolute directory for isolated demo/test persistence.
# RELIEF_DATA_DIR=C:/path/to/isolated-demo-data
